# Normalize line endings for text; Godot reads LF fine on every platform.
* text=auto eol=lf
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.glb binary

# Game art imported into the main project lives under assets/ and goes through Git LFS.
# (The archived prototype under prototypes/ predates LFS and stays as plain blobs.)
assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/**/*.res filter=lfs diff=lfs merge=lfs -text
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
