; Engine configuration file.
; Lowlight Island — Godot 4 project.

config_version=5

[application]

config/name="Lowlight Island"
config/description="First-person co-op survival horror for 2-4 friends."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Tuning="*res://src/autoload/tuning.gd"
Settings="*res://src/autoload/settings.gd"
Net="*res://src/autoload/net.gd"
Sfx="*res://src/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
anti_aliasing/quality/msaa_3d=1
